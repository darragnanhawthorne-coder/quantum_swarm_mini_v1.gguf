# 3. LOCAL MEMORY ENGINE (SQLite RAG Backing Layer)
# ==============================================================================
class LocalMemoryEngine:
    def __init__(self, db_path: Path = DB_PATH):
        self.conn = sqlite3.connect(str(db_path))
        self.create_tables()

    def create_tables(self):
        cursor = self.conn.cursor()
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS knowledge_base (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                source TEXT,
                chunk_index INTEGER,
                content TEXT,
                timestamp DATETIME DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        self.conn.commit()

    def store_document_chunks(self, source: str, chunks: List[str]):
        """Injects individual document strings directly inside storage schemas."""
        cursor = self.conn.cursor()
        for idx, chunk in enumerate(chunks):
            cursor.execute(
                "INSERT INTO knowledge_base (source, chunk_index, content) VALUES (?, ?, ?)",
                (source, idx, chunk)
            )
        self.conn.commit()
        print(f"[+] Ingestion complete: Loaded {len(chunks)} text chunks from source -> {source}")

    def query_memory(self, term: str) -> str:
        cursor = self.conn.cursor()
        cursor.execute("SELECT source, content FROM knowledge_base WHERE content LIKE ? LIMIT 3", (f"%{term}%",))
        results = cursor.fetchall()
        if not results:
            return "No localized domain knowledge context matches found."
        return "\n".join([f"[{r[0]}]: {r[1]}" for r in results])

