        self.chunk_size = chunk_size
        self.chunk_overlap = chunk_overlap

    def clean_text(self, text: str) -> str:
        """Removes extraneous whitespace and unprintable layout noise."""
        text = re.sub(r'\s+', ' ', text)
        return text.strip()

    def chunk_document(self, text: str) -> List[str]:
        """Slices raw text into overlapping boundaries to protect text context."""
        cleaned = self.clean_text(text)
        words = cleaned.split(" ")
        chunks = []
        
        i = 0
        while i < len(words):
            # Form chunk by tracking word ranges
            end_idx = min(i + self.chunk_size, len(words))
            chunk_words = words[i:end_idx]
            chunks.append(" ".join(chunk_words))
            
            # Slide window forward by size minus targeted boundary overlap
            if end_idx == len(words):
                break
            i += (self.chunk_size - self.chunk_overlap)
            
        return chunks

