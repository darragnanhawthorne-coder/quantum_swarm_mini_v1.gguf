# 4. GGUF CONTAINER COMPILER & ENGINE GENERATOR
# ==============================================================================
def write_string(f, val):
    """Writes a standard string according to GGUF specs (uint64 size prefix)."""
    encoded = val.encode('utf-8')
    f.write(struct.pack("<Q", len(encoded)))
    f.write(encoded)

def write_val(f, val_type, val):
    """Injects typed metadata data segments cleanly into the file layout."""
    f.write(struct.pack("<I", val_type))
    if val_type == GGUF_TYPE_STRING:
        write_string(f, val)
    elif val_type == GGUF_TYPE_UINT32:
        f.write(struct.pack("<I", val))
    elif val_type == GGUF_TYPE_INT32:
        f.write(struct.pack("<i", val))

def compile_and_render_gguf(output_path: Path) -> bool:
    """Compiles and renders the explicit local GGUF metadata schema profile."""
    print(f"[*] Compiling deployment blueprint metadata parameters into GGUF...")
    
    metadata = {
        "general.architecture": (GGUF_TYPE_STRING, "minicpm"),
        "general.name": (GGUF_TYPE_STRING, "Quantum-Swarm-Autonomous-Agent"),
        "general.quantization_version": (GGUF_TYPE_UINT32, 2),
        "general.file_type": (GGUF_TYPE_UINT32, 2),  # Target Q4_K_M profiling constraints
        "minicpm.context_length": (GGUF_TYPE_UINT32, 4096),
        "minicpm.embedding_length": (GGUF_TYPE_UINT32, 2048),
        "tokenizer.chat_template": (GGUF_TYPE_STRING, (
            "{{- bos_token }}\n"
            "{%- if messages['role'] == 'system' -%}\n"
            "  {{- 'SYSTEM: ' + messages['content'] + '\\n' -%}\n"
            "{%- endif -%}\n"
            "{%- for message in messages -%}\n"
            "  {%- if message['role'] == 'user' -%}\n"
            "    {{- 'USER: ' + message['content'] + '\\n' -%}\n"
            "  {%- elif message['role'] == 'assistant' -%}\n"
