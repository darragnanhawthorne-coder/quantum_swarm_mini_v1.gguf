while true; do
    if [ -f "$TARGET_DB" ]; then
        TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
        BACKUP_FILE="$BACKUP_DIR/memory_snapshot_$TIMESTAMP.db"
        
        # Perform low-overhead clean copy tracking clone operations
